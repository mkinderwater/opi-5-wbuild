#!/bin/bash
# No downloads, shell-sourced configuration, or board-specific interface names.
set -euo pipefail
export LC_ALL=C
STATE=/var/lib/chatbox
CONFIG_MOUNT=/run/chatbox-config
mkdir -p "$STATE" "$CONFIG_MOUNT"
fail() { printf 'ERROR: %s\n' "$*"; exit 1; }
cleanup() { if mountpoint -q "$CONFIG_MOUNT"; then umount "$CONFIG_MOUNT" || true; fi; }
trap cleanup EXIT
# Generated by our builder. Only fixed numeric identifiers are read.
ROOT_ID=$(sed -n 's/^ROOT_PARTUUID=//p' /etc/chatbox/platform.conf)
CONFIG_ID=$(sed -n 's/^CONFIG_PARTUUID=//p' /etc/chatbox/platform.conf)
[[ "$ROOT_ID" =~ ^[0-9a-f]{8}-02$ ]] || fail 'Invalid root identity'
[[ "$CONFIG_ID" =~ ^[0-9a-f]{8}-01$ ]] || fail 'Invalid config identity'

# Independent resize retry service, even if CONFIG.TXT needs correction.
/usr/local/sbin/chatbox-resize || echo 'Root expansion deferred; it will retry next boot.'

mount_config() {
    udevadm settle --timeout=10 || true
    mount -t vfat -o rw,sync,umask=0077 "/dev/disk/by-partuuid/$CONFIG_ID" "$CONFIG_MOUNT"
}

# A durable credentials-ready marker permits credential scrubbing to resume
# after power loss without ever needing the original plaintext password again.
if [ ! -e "$STATE/credentials-ready" ]; then
    mount_config
    [ -f "$CONFIG_MOUNT/CONFIG.TXT" ] || fail 'CONFIG.TXT missing'
    # Validate and parse to private files, not shell code or process arguments.
    mkdir -p /run/chatbox-provision
    chmod 700 /run/chatbox-provision
    perl /usr/local/sbin/chatbox-config "$CONFIG_MOUNT/CONFIG.TXT" /run/chatbox-provision
    cleanup
    timezone=$(cat /run/chatbox-provision/timezone)
    [ -f "/usr/share/zoneinfo/$timezone" ] || fail 'Timezone unavailable'
    chpasswd </run/chatbox-provision/chpasswd || fail 'Password provisioning failed'
    rm -f /run/chatbox-provision/chpasswd
    ln -sfn "/usr/share/zoneinfo/$timezone" /etc/localtime
    printf '%s\n' "$timezone" >/etc/timezone
    device_id=$(tr -d '\n' </etc/machine-id)
    [[ "$device_id" =~ ^[0-9a-f]{32}$ ]] || fail 'Unique machine ID unavailable'
    name=$(cat /run/chatbox-provision/hostname)
    [ -n "$name" ] || name="chatbox-${device_id:0:8}"
    printf '%s\n' "$name" >/etc/hostname
    hostname "$name"
    printf '127.0.0.1 localhost\n127.0.1.1 %s\n::1 localhost ip6-localhost ip6-loopback\n' "$name" >/etc/hosts
    rm -rf /run/chatbox-provision
    mkdir -p /etc/ssh/sshd_config.d /run/sshd
    cat >/etc/ssh/sshd_config.d/00-chatbox.conf <<'EOF_SSH'
PermitRootLogin yes
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
EOF_SSH
    chmod 600 /etc/ssh/sshd_config.d/00-chatbox.conf
    ssh-keygen -A
    /usr/sbin/sshd -t
    effective=$(/usr/sbin/sshd -T -C user=root,host=localhost,addr=127.0.0.1)
    grep -qx 'permitrootlogin yes' <<<"$effective" || fail 'SSH root policy differs'
    grep -qx 'passwordauthentication yes' <<<"$effective" || fail 'SSH password policy differs'
    touch "$STATE/credentials-ready"
    sync
fi

# Resume at this point if credentials were committed on an earlier boot.
if [ ! -e "$STATE/provisioned" ]; then
    mountpoint -q "$CONFIG_MOUNT" || mount_config
    if [ -f "$CONFIG_MOUNT/CONFIG.TXT" ]; then
        temp="$CONFIG_MOUNT/CONFIG.NEW"
        umask 077
        awk '/^ROOT_PASSWORD=/{print "ROOT_PASSWORD=";next}{print}' "$CONFIG_MOUNT/CONFIG.TXT" >"$temp"
        sync
        mv -f "$temp" "$CONFIG_MOUNT/CONFIG.TXT"
        sync
        ! grep -Eq '^ROOT_PASSWORD=.+' "$CONFIG_MOUNT/CONFIG.TXT" || fail 'Password scrub failed'
    fi
    cleanup
    touch "$STATE/provisioned"
    sync
fi
systemctl unmask ssh.service sshd.service
systemctl enable ssh.service
# Do not synchronously start a service ordered After this running oneshot.
systemctl start --no-block ssh.service
printf 'Credentials provisioned; readiness service will verify Ethernet and SSH.\n'
